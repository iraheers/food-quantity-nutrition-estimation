import chromadb

# Step 1: Create an in-memory Chroma client (data will be lost after session ends)
client = chromadb.EphemeralClient()

# Step 2: Create or get the 'foods' collection
collection = client.get_or_create_collection(name="foods")

# Step 3: Define descriptive food items
food_items = [
    "banana - a yellow tropical fruit",
    "apple - a sweet red fruit",
    "grapes - small round sweet fruit",
    "orange - citrus fruit rich in vitamin C",
    "blueberry - a small blue fruit used in desserts",
    "broccoli - a green vegetable",
    "spinach - leafy green vegetable rich in iron",
    "carrot - a crunchy orange root vegetable",
    "fried chicken - crispy deep-fried chicken meat",
    "grilled salmon - cooked fish rich in protein",
    "oatmeal - a healthy warm breakfast made from oats",
    "cheeseburger - a sandwich with beef and cheese",
    "quinoa - a grain high in protein and fiber",
    "lentils - small legumes used in curries and soups",
    "almonds - crunchy tree nuts rich in healthy fats"
]
ids = [str(i) for i in range(len(food_items))]

# Step 4: Add documents (optional: wrap in try/except to avoid re-adding)
try:
    collection.add(documents=food_items, ids=ids)
except Exception as e:
    print("Documents may already be added in this session. Skipping re-add.")

# Step 5: Perform a semantic query
query_text = "banana - a yellow fruit"
results = collection.query(query_texts=[query_text], n_results=3)

# Step 6: Print results
print(f"\nTop 3 similar foods to: '{query_text}'")
for i, doc in enumerate(results['documents'][0]):
    print(f"{i+1}. {doc}")

