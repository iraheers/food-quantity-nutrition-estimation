from PIL import Image
import requests

img_url = "https://images.unsplash.com/photo-1600891964599-f61ba0e24092"
response = requests.get(img_url, stream=True)
image = Image.open(response.raw).convert("RGB")
image.show()

from transformers import BlipProcessor, BlipForConditionalGeneration

# Load BLIP-2 model and processor
blip_processor = BlipProcessor.from_pretrained("Salesforce/blip-image-captioning-base")
blip_model = BlipForConditionalGeneration.from_pretrained("Salesforce/blip-image-captioning-base")

# Process and generate caption
blip_inputs = blip_processor(image, return_tensors="pt")
blip_output = blip_model.generate(**blip_inputs)
blip_caption = blip_processor.decode(blip_output[0], skip_special_tokens=True)

print("BLIP-2 Caption:", blip_caption)

