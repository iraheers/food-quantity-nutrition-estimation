def get_nutrition(food_name):
    cursor.execute("SELECT * FROM foods WHERE name LIKE ?", (f"%{food_name}%",))
    result = cursor.fetchone()
    if result:
        print(f"\nNutrition for {result[1]}:")
        print(f"Calories: {result[2]} kcal")
        print(f"Protein: {result[3]} g")
        print(f"Carbs: {result[4]} g")
        print(f"Fat: {result[5]} g")
    else:
        print(f"{food_name} not found.")

