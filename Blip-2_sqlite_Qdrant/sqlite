from datasets import load_dataset

# Load just 10 images for now
dataset = load_dataset("food101", split="train[:10]")

from transformers import Blip2Processor, Blip2ForConditionalGeneration
import torch

device = "cuda" if torch.cuda.is_available() else "cpu"

# Load BLIP-2 model (OPT version)
processor = Blip2Processor.from_pretrained("Salesforce/blip2-opt-2.7b")
model = Blip2ForConditionalGeneration.from_pretrained("Salesforce/blip2-opt-2.7b", torch_dtype=torch.float16 if device=="cuda" else torch.float32)
model.to(device)

from PIL import Image

for example in dataset:
    image = example["image"]

    prompt = "Question: What food is shown in this image? Answer:"
    inputs = processor(images=image, text=prompt, return_tensors="pt").to(device)

    with torch.no_grad():
        output = model.generate(**inputs, max_new_tokens=20)

    caption = processor.tokenizer.decode(output[0], skip_special_tokens=True)
    print(f"Predicted: {caption} | Actual: {dataset.features['label'].names[example['label']]}")

